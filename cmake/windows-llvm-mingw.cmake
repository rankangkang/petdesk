# Cross-compile the Windows x64 build with an LLVM-MinGW UCRT toolchain.
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
if(NOT DEFINED ENV{PETDESK_LLVM_MINGW_ROOT})
    message(FATAL_ERROR "Set PETDESK_LLVM_MINGW_ROOT to the LLVM-MinGW toolchain directory")
endif()
file(TO_CMAKE_PATH "$ENV{PETDESK_LLVM_MINGW_ROOT}" PETDESK_LLVM_MINGW_ROOT)
set(CMAKE_C_COMPILER "${PETDESK_LLVM_MINGW_ROOT}/bin/x86_64-w64-mingw32-clang")
set(CMAKE_CXX_COMPILER "${PETDESK_LLVM_MINGW_ROOT}/bin/x86_64-w64-mingw32-clang++")
set(CMAKE_RC_COMPILER "${PETDESK_LLVM_MINGW_ROOT}/bin/x86_64-w64-mingw32-windres")
set(CMAKE_AR "${PETDESK_LLVM_MINGW_ROOT}/bin/x86_64-w64-mingw32-ar")
set(CMAKE_RANLIB "${PETDESK_LLVM_MINGW_ROOT}/bin/x86_64-w64-mingw32-ranlib")
set(CMAKE_FIND_ROOT_PATH "${PETDESK_LLVM_MINGW_ROOT}/x86_64-w64-mingw32")
if(DEFINED ENV{PETDESK_QT_WINDOWS_ROOT})
    list(APPEND CMAKE_FIND_ROOT_PATH "$ENV{PETDESK_QT_WINDOWS_ROOT}")
endif()
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
